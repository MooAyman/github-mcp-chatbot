# OpenAI (primary LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (fallback LLM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# GitHub
GITHUB_PERSONAL_ACCESS_TOKEN=
# Docker Compose only: HTTP MCP service URL (omit for local stdio via docker run)
GITHUB_MCP_URL=

# Langfuse observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Application
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_URL=http://127.0.0.1:8000
# Docker Compose overrides this to http://backend:8000 in docker-compose.yml
